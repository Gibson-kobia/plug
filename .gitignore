# ============================================================
# Kenya Electronics Marketplace — .gitignore
# Next.js + React + TypeScript + Supabase + Node + Vercel
# ============================================================

# ------------------------------------------------------------
# Dependencies
# ------------------------------------------------------------
node_modules/
.pnp/
.pnp.js
.yarn/install-state.gz

# ------------------------------------------------------------
# Next.js build output + cache
# ------------------------------------------------------------
.next/
out/
build/
dist/
.turbo/
.npm/cache/

# ------------------------------------------------------------
# Vercel
# ------------------------------------------------------------
.vercel
.vercel_build_output

# ------------------------------------------------------------
# Supabase local development (supabase CLI)
# ------------------------------------------------------------
.supabase/
supabase/.temp/
supabase/config.toml.local

# ------------------------------------------------------------
# Production secrets & environment — NEVER commit these
# ------------------------------------------------------------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local

# Keys, tokens, certs
*.pem
*.key
*.crt
*.p12
*.pfx
*.pub.sig
secrets/
.keys/

# ------------------------------------------------------------
# Logs & debugging
# ------------------------------------------------------------
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Server logs
logs/
*.log

# Runtime data
pids/
*.pid
*.seed
*.pid.lock
coverage/
.nyc_output/

# ------------------------------------------------------------
# TypeScript / ESLint / Prettier caches
# ------------------------------------------------------------
*.tsbuildinfo
.next-env.d.ts.backup
.cache/
.parcel-cache/
.eslintcache
.stylelintcache

# ------------------------------------------------------------
# Testing
# ------------------------------------------------------------
coverage/
playwright-report/
playwright/.cache/
playwright/test-results/
cypress/videos/
cypress/screenshots/

# ------------------------------------------------------------
# Editor / IDE
# ------------------------------------------------------------
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json

# ------------------------------------------------------------
# OS / misc
# ------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# ------------------------------------------------------------
# Large media placeholders — admin uploads go to Supabase Storage, NOT git
# ------------------------------------------------------------
# All actual product/lifestyle images live in Supabase Storage bucket.
# If you accidentally drop a test image here, it will be ignored:
public/images/products/**
public/uploads/**
uploads/**
*.iso
*.zip
*.tar.gz
*.rar
*.7z
*.mp4

# ------------------------------------------------------------
# Temporary local-only overrides
# ------------------------------------------------------------
*.local
*.bak
*.swp
*.swo
*~
